# Copy to .env in this folder (found by searching up from the installed source,
# so use an editable install). Set only what the providers you run need.

# --provider openai / claude / muse
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MUSE_API_KEY=

# --provider deepseek / glm / qwen / devstral / gpt-oss (self-hosted, OpenAI-compatible).
# LLM_BASE_URL points at your own server (vLLM :8000/v1, Ollama :11434/v1, ...).
LLM_BASE_URL=
LLM_API_KEY=
# none turns Qwen3's thinking off; not read by openai or glm.
LLM_REASONING_EFFORT=

# Records run at once per provider in a batch; a provider not named runs one at a time.
SECPAT_PARALLEL=openai=4,claude=2,muse=4

# Interaction order (stage 3) and Level 3 scoring. Set a Joern query service,
# or leave JOERN_SERVICE_URL unset to run a local Joern install.
JOERN_SERVICE_URL=
JOERN_SERVICE_TOKEN=
# Local Joern only:
# JOERN_BIN=joern
# JOERN_PARSE_BIN=joern-parse
# JOERN_CPG_ROOT=~/.cache/secpat/joern_cpg
