# Copy to .env in this folder and fill in only what you run. The secpat command
# reads this file (editable install); `secpat recover --models` checks the
# selected models' settings before a run starts.

# gpt-6.1-sol (--provider openai)
OPENAI_API_KEY=

# muse-spark-1.3-contributor (--provider muse)
MUSE_API_KEY=

# deepseek-v4-flash-0731 and glm-5.3-flash (--provider deepseek / glm), each on
# its own OpenAI-compatible server on Modal. The URLs end in /v1;
# `secpat recover --models` passes each model its own. MODAL_KEY / MODAL_SECRET
# are a Modal proxy auth token (Modal dashboard, Settings -> Proxy Auth Tokens).
DEEPSEEK_BASE_URL=
GLM_BASE_URL=
MODAL_KEY=
MODAL_SECRET=
# Calling `secpat --provider deepseek|glm` yourself: the server URL, and the
# reasoning effort forwarded to deepseek (glm uses its own fixed setting).
LLM_BASE_URL=
LLM_REASONING_EFFORT=

# `secpat pack --measure` counts tokens with Anthropic's count_tokens endpoint.
ANTHROPIC_API_KEY=

# Interaction order (stage 3) and Level 3 scoring outside `secpat interaction`
# and `secpat recover --models` (which always use local Joern): a Joern query
# service, or leave JOERN_SERVICE_URL unset to run a local Joern install.
JOERN_SERVICE_URL=
JOERN_SERVICE_TOKEN=
# JOERN_BIN=joern
# JOERN_PARSE_BIN=joern-parse
# JOERN_CPG_ROOT=~/.cache/secpat/joern_cpg
